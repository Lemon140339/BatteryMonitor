{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BatteryMonitor 设备描述",
  "description": "描述一台无线设备的电量读取方式。字段说明见 docs/ADD_DEVICE.md",
  "type": "object",
  "required": ["name", "vid", "pid", "battery"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "编辑器提示用，可保留"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "显示在屏幕上的名字，例如 IN10"
    },
    "vid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{4}$",
      "description": "厂商 ID，4 位十六进制，例如 1D57"
    },
    "pid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{4}$",
      "description": "产品 ID，4 位十六进制，例如 FA65"
    },
    "iface": {
      "type": "string",
      "description": "接口路径片段，用来区分同一设备的多个集合，例如 col03 / mi_03；留空则自动选择"
    },
    "mode": {
      "enum": ["passive", "query"],
      "default": "passive",
      "description": "passive = 被动监听设备上报；query = 主动发送查询帧"
    },
    "battery": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "电量所在字节的下标（从 0 开始；第一个字节写 0）"
    },
    "readLength": {
      "type": "integer",
      "minimum": 1,
      "description": "passive 模式每次读取的字节数，必须等于报告长度"
    },
    "match": {
      "type": "object",
      "description": "passive 模式的帧特征，全部命中才当作电量帧",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(0x[0-9A-Fa-f]{1,2}|[0-9]{1,3})$"
      },
      "examples": [{ "1": "0x93", "2": "0x40" }]
    },
    "query": {
      "type": "object",
      "description": "query 模式的发送帧",
      "required": ["length"],
      "properties": {
        "length": {
          "type": "integer",
          "minimum": 1,
          "description": "发送帧总长度（含报告 ID）"
        },
        "set": {
          "type": "object",
          "description": "固定字节，未列出的补 0",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(0x[0-9A-Fa-f]{1,2}|[0-9]{1,3})$"
          },
          "examples": [{ "0": "0x00", "1": "0x20", "2": "0x01" }]
        },
        "checksum": { "$ref": "#/definitions/checksum" }
      }
    },
    "response": {
      "type": "object",
      "description": "query 模式的回复帧",
      "required": ["length"],
      "properties": {
        "length": { "type": "integer", "minimum": 1 },
        "checksum": { "$ref": "#/definitions/checksum" }
      }
    },
    "pollIntervalMs": {
      "type": "integer",
      "minimum": 100,
      "default": 30000,
      "description": "query 模式的轮询间隔（毫秒）"
    },
    "retryDelayMs": {
      "type": "integer",
      "minimum": 100,
      "default": 5000,
      "description": "读取失败后的重试间隔（毫秒）"
    }
  },
  "definitions": {
    "checksum": {
      "type": "object",
      "description": "校验方式。目前只支持 sum8：把 range 区间求和取低 8 位写到 at 位置",
      "required": ["type", "at"],
      "properties": {
        "type": { "enum": ["sum8", "none"] },
        "range": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2,
          "description": "[起始下标, 结束下标]，闭区间"
        },
        "at": { "type": "integer", "minimum": 0, "description": "校验和写入的下标" }
      }
    }
  }
}
