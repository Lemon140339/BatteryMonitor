{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BatteryMonitor 设备描述",
  "description": "描述一台无线设备的电量读取方式。字段说明见 docs/ADD_DEVICE.md",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": { "protocol": { "const": "hidpp2" } },
        "required": ["protocol"]
      },
      "then": { "required": ["name", "vid"] },
      "else": { "required": ["name", "vid", "battery"] }
    }
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "编辑器提示用，可保留"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "显示在屏幕上的名字，例如 IN10。用了 models 时这是认不出型号时的通用名"
    },
    "vid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{4}$",
      "description": "厂商 ID，4 位十六进制，例如 1D57"
    },
    "pid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{4}$",
      "description": "产品 ID，4 位十六进制，例如 FA65。单个设备用这个；一个接收器家族有多份 PID 时改用 pids"
    },
    "pids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[0-9A-Fa-f]{4}$" },
      "description": "一组接收器 PID：同一个接收器家族共用一份配置（与 pid 二选一）"
    },
    "iface": {
      "type": "string",
      "description": "接口路径片段，用来区分同一设备的多个集合，例如 col03 / mi_03；留空则自动选择"
    },
    "usage": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{1,4}/[0-9A-Fa-f]{1,4}$",
      "description": "按 HID usage 选接口，写法 \"FF02/0002\"（usage 页 / usage）。比 iface 稳：同一接收器的多个集合 colNN 会随固件变"
    },
    "protocol": {
      "enum": ["hidpp2"],
      "description": "协议判别式。留空 = 传统字节表协议（passive / query）；hidpp2 = 罗技 HID++ 2.0，电量由代码读，JSON 只留身份信息"
    },
    "mode": {
      "enum": ["passive", "query"],
      "default": "passive",
      "description": "passive = 被动监听设备上报；query = 主动发送查询帧"
    },
    "io": {
      "enum": ["output", "feature"],
      "default": "output",
      "description": "query 模式的写入通道：output = WriteFile 走中断端点；feature = HidD_SetFeature 走 Feature 报告"
    },
    "battery": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "电量所在字节的下标（从 0 开始；第一个字节写 0）"
    },
    "scale": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "电量倍率：原始值 × scale；按 10% 档上报的写 10（值 8 表示 80%）"
    },
    "minPercent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 0,
      "description": "有效电量下限：低于它当作无效包。有些协议拿 0 表示休眠/链路断开"
    },
    "charging": {
      "type": "object",
      "description": "充电/有线标志：某个字节非 0 即认为在充电（或接着线）",
      "required": ["offset"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0, "description": "标志字节下标" },
        "nonZero": { "type": "boolean", "default": true, "description": "true = 非 0 表示充电" },
        "values": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(0x[0-9A-Fa-f]{1,2}|[0-9]{1,3})$" },
          "description": "只认这些取值才算充电（例如 MCHOSE 的 0x01）；留空则按 nonZero 判断"
        }
      }
    },
    "readLength": {
      "type": "integer",
      "minimum": 1,
      "description": "passive 模式每次读取的字节数，必须等于报告长度"
    },
    "match": {
      "type": "object",
      "description": "passive 模式的帧特征，全部命中才当作电量帧",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(0x[0-9A-Fa-f]{1,2}|[0-9]{1,3})$"
      },
      "examples": [{ "1": "0x93", "2": "0x40" }]
    },
    "modelIndex": {
      "type": "integer",
      "minimum": 0,
      "description": "passive 模式：报文里“型号 ID”的字节下标。配合 models，一份配置可识别同一接收器下的多个型号"
    },
    "models": {
      "type": "object",
      "description": "型号 ID（或 hidpp2 的 WPID）-> 显示名 / 电量倍率；键写 0x93 这种十六进制",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "scale": {
            "type": "integer",
            "minimum": 1,
            "description": "电量倍率，默认 1；按 10% 档上报的型号填 10（值 8 表示 80%）"
          }
        },
        "required": ["name"]
      },
      "examples": [{ "0x93": { "name": "IN10" }, "0x10": { "name": "R1", "scale": 10 } }]
    },
    "query": {
      "type": "object",
      "description": "query 模式的发送帧",
      "required": ["length"],
      "properties": {
        "length": {
          "type": "integer",
          "minimum": 1,
          "description": "发送帧总长度（含报告 ID）"
        },
        "set": {
          "type": "object",
          "description": "固定字节，未列出的补 0",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(0x[0-9A-Fa-f]{1,2}|[0-9]{1,3})$"
          },
          "examples": [{ "0": "0x00", "1": "0x20", "2": "0x01" }]
        },
        "checksum": { "$ref": "#/definitions/checksum" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "description": "同一族设备的多种方言：按顺序逐个试，每项带自己的 set / checksum / expect / verify",
          "items": {
            "type": "object",
            "properties": {
              "set": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^(0x[0-9A-Fa-f]{1,2}|[0-9]{1,3})$"
                }
              },
              "checksum": { "$ref": "#/definitions/checksum" },
              "expect": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^(0x[0-9A-Fa-f]{1,2}|[0-9]{1,3})$"
                }
              },
              "verify": { "$ref": "#/definitions/checksum" }
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "description": "query 模式的回复帧",
      "required": ["length"],
      "properties": {
        "length": { "type": "integer", "minimum": 1 },
        "expect": {
          "type": "object",
          "description": "应答特征：下标 -> 期望值，全部命中才认这一帧（回显校验）",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(0x[0-9A-Fa-f]{1,2}|[0-9]{1,3})$"
          },
          "examples": [{ "0": "0x08", "1": "0x04" }]
        },
        "checksum": { "$ref": "#/definitions/checksum" }
      }
    },
    "payloadXor": {
      "type": "string",
      "pattern": "^0x[0-9A-Fa-f]{1,2}$",
      "description": "整包异或的掩码，例如 \"0xFF\"：写帧时异或 [1..end]，解帧时异或 [2..end]"
    },
    "retries": {
      "type": "integer",
      "minimum": 1,
      "default": 2,
      "description": "单次查询的重试次数：休眠设备常常第一个包不应答"
    },
    "wakeDelayMs": {
      "type": "integer",
      "minimum": 0,
      "default": 120,
      "description": "Feature 报告写入后等多久再读（毫秒）"
    },
    "pollIntervalMs": {
      "type": "integer",
      "minimum": 100,
      "default": 30000,
      "description": "query 模式的轮询间隔（毫秒）"
    },
    "retryDelayMs": {
      "type": "integer",
      "minimum": 100,
      "default": 5000,
      "description": "读取失败后的重试间隔（毫秒）"
    }
  },
  "definitions": {
    "checksum": {
      "type": "object",
      "description": "校验方式：sum8 = 区间和取低 8 位写到 at；sumTo = 让区间和 + 校验字节 ≡ target（mod 256）；none = 不校验",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["sum8", "sumTo", "none"] },
        "range": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2,
          "description": "[起始下标, 结束下标]，闭区间"
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "description": "校验和所在下标（写入时必填；sumTo 校验时可不填）"
        },
        "target": {
          "type": "string",
          "pattern": "^(0x[0-9A-Fa-f]{1,2}|[0-9]{1,3})$",
          "description": "sumTo 的目标值，例如 \"0x55\""
        }
      }
    }
  }
}
